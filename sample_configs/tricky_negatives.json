{
  "account": {"root_mfa_enabled": true, "root_access_keys": 0},
  "s3_buckets": [
    {"name": "internal-docs", "public_access_block": true, "encryption": true, "versioning": true}
  ],
  "security_groups": [
    {"id": "sg-office-ssh", "ingress": [{"from_port": 22, "to_port": 22, "cidr": "10.0.0.0/8"}]},
    {"id": "sg-web", "ingress": [{"from_port": 443, "to_port": 443, "cidr": "0.0.0.0/0"}, {"from_port": 80, "to_port": 80, "cidr": "0.0.0.0/0"}]}
  ],
  "iam_users": [
    {"name": "build-bot", "console_access": false, "mfa_enabled": false, "access_key_age_days": 90}
  ],
  "iam_policies": [
    {"name": "ScopedWildcard", "statements": [{"effect": "Allow", "action": "s3:*", "resource": "arn:aws:s3:::internal-docs/*"}]},
    {"name": "DenyAll", "statements": [{"effect": "Deny", "action": "*", "resource": "*"}]}
  ],
  "cloudtrail": {"enabled": true, "multi_region": true},
  "ebs_volumes": [{"id": "vol-ok", "encrypted": true}],
  "rds_instances": [{"id": "db-ok", "publicly_accessible": false, "encrypted": true}]
}
